{
  "version": "1.1",
  "mode": "strict",
  "policy": {
    "useOnlyCanonicalProductionAssets": true,
    "referencesNeverRenderedOnPublicWebsite": true,
    "legacyGeneratedAssetsForbidden": true,
    "missingCanonicalAssetBehavior": "show neutral placeholder or leave slot empty; never synthesize/rebuild",
    "packagingMayBeTransformedButNotRedesigned": true,
    "charactersMayBeTransformedButNotRedesigned": true
  },
  "forbiddenLegacyGlobs": [
    "assets/products/*-wrap.webp",
    "assets/campaign/crew-hero.webp"
  ],
  "canonical": {
    "packagingReferences": {
      "glow": "assets/canonical/references/packaging/glow-packaging-board.png",
      "flex": "assets/canonical/references/packaging/flex-packaging-board.png",
      "snoozy": "assets/canonical/references/packaging/snoozy-packaging-board.png",
      "daily": "assets/canonical/references/packaging/daily-packaging-board.png"
    },
    "characterReferences": {
      "glow": "assets/canonical/references/characters/glow-character-bible.png",
      "flex": "assets/canonical/references/characters/flex-character-bible.png",
      "snoozy": "assets/canonical/references/characters/snoozy-character-bible.png",
      "daily": "assets/canonical/references/characters/daily-character-bible.png"
    },
    "production": {
      "jars": {
        "glow": {
          "front": "assets/products/glow-front.webp"
        },
        "flex": {
          "front": "assets/products/flex-front.webp"
        },
        "snoozy": {
          "front": "assets/products/snoozy-front.webp"
        },
        "daily": {
          "front": "assets/products/daily-front.webp"
        }
      },
      "characters": {
        "glow": "assets/characters/glow.webp",
        "flex": "assets/characters/flex.webp",
        "snoozy": "assets/characters/snoozy.webp",
        "daily": "assets/characters/daily.webp"
      },
      "characterDuplicates": {
        "glow": "assets/characters/glow-bust.webp",
        "flex": "assets/characters/flex-bust.webp",
        "snoozy": "assets/characters/snoozy-bust.webp",
        "daily": "assets/characters/daily-bust.webp"
      }
    }
  },
  "futureViews": {
    "jars": [
      "3q-front",
      "side",
      "back",
      "open"
    ],
    "characterPoses": [
      "hero-alt",
      "pdp-alt"
    ]
  },
  "note": "Since the approved asset package (baerly-website-assets.zip) the production files live at assets/products/<id>-front.webp and assets/characters/<id>.webp. They replace the earlier generated images that used the same names. assets/canonical/ keeps the reference boards."
}